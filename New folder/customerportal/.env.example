# Galvabond Customer Portal — Environment Variables Template
#
# Copy this file to `.env` (for local dev) or configure these as
# environment variables in your hosting provider (Vercel, Netlify,
# Cloudflare Pages, etc.) for staging / production builds.
#
# IMPORTANT: Variables prefixed with VITE_ are exposed to the client
# bundle at build time. Only put PUBLISHABLE / ANON keys here — never
# service-role keys, JWT secrets, or database passwords.

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase publishable / anon key. This is safe to ship to the browser
# because it's gated by Row Level Security policies on the database.
VITE_SUPABASE_ANON_KEY=
